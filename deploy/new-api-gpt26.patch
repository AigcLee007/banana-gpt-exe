+package dto
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestImageRequestPreservesGPTImage26Parameters(t *testing.T) {
+	input := []byte(`{"model":"gpt-image-2.6-sunburst-1k","prompt":"animation","output_format":"gif","complexity":"high","frame_count":9,"frame_duration_ms":200,"svg":{"model":"gpt-6.1-sol"},"unrecognized_private_field":"omit"}`)
+	var request ImageRequest
+	require.NoError(t, json.Unmarshal(input, &request))
+	// ImageHelper deep-copies the request before applying the channel's model mapping.
+	copyJSON, err := json.Marshal(request)
+	require.NoError(t, err)
+	var copied ImageRequest
+	require.NoError(t, json.Unmarshal(copyJSON, &copied))
+	copied.SetModelName("gpt-image-2.6-sunburst")
+	out, err := json.Marshal(copied)
+	require.NoError(t, err)
+	var actual map[string]json.RawMessage
+	require.NoError(t, json.Unmarshal(out, &actual))
+	for key, expected := range map[string]string{
+		"model": `"gpt-image-2.6-sunburst"`, "complexity": `"high"`,
+		"frame_count": "9", "frame_duration_ms": "200", "svg": `{"model":"gpt-6.1-sol"}`,
+	} {
+		assert.JSONEq(t, expected, string(actual[key]), key)
+	}
+	assert.NotContains(t, actual, "unrecognized_private_field", "unrecognized fields must remain filtered")
+}
+
+func TestImageRequestGPTImage26OptionalScalars(t *testing.T) {
+	for _, input := range []string{
+		`{"model":"image","prompt":"test"}`,
+		`{"model":"image","prompt":"test","frame_count":0,"frame_duration_ms":0}`,
+	} {
+		var request ImageRequest
+		require.NoError(t, json.Unmarshal([]byte(input), &request))
+		out, err := json.Marshal(request)
+		require.NoError(t, err)
+		var before, after map[string]json.RawMessage
+		require.NoError(t, json.Unmarshal([]byte(input), &before))
+		require.NoError(t, json.Unmarshal(out, &after))
+		for _, key := range []string{"frame_count", "frame_duration_ms"} {
+			assert.Equal(t, string(before[key]), string(after[key]), "optional %s must preserve absence and zero", key)
+		}
+	}
+}
